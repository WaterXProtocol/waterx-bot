# Copy this file to `.env` and fill in real values (this is the PRODUCTION
# config, loaded by default with `cargo run`). For the dev bot, see
# `.env.dev.example` and run it with `ENV_FILE=.env.dev cargo run`.

# Required: Telegram bot token from @BotFather
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Required: your Telegram user id (numeric) — for owner-only commands
# (/mint, /pause, /unpause, /broadcast are gated on this id)
BOT_OWNER=0

# Optional: dev mode (default true). Selects the SQLite data file and the
# envelope-drop rule:
#   true  → waterx-dev.db; envelope drops anywhere (groups *and* private chats)
#   false → waterx.db;     envelope drops only in non-private (group) chats
BOT_DEV=false

# Optional: Telegram Mini App URL (must be https://). When set, the bot points
# its chat menu button (next to the message input) at this Web App and adds an
# "Open app" button to the private home menu. Leave unset to disable both.
# See miniapp/README.md for a ready-to-host sample page + setup steps.
# MINI_APP_URL=https://your-domain.example/miniapp/
