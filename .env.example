# Copy this file to `.env` and fill in real values.

# Required: Telegram bot token from @BotFather
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Required: your Telegram user id (numeric) — for owner-only commands
BOT_OWNER=0

# Required: bot name; doubles as the SQLite filename (no extension)
BOT_NAME=waterx

# Optional: dev mode. true → envelope drops only in private chats.
# false (default) → envelope drops only in non-private (group) chats.
BOT_DEV=false
