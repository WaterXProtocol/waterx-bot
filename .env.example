# Copy this file to `.env` and fill in real values.

# Required: Telegram bot token from @BotFather
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Required: your Telegram user id (numeric) — for owner-only commands
BOT_OWNER=0

# Optional: dev mode (default true).
#   true  → envelope drops anywhere (groups *and* private chats); /mint enabled
#   false → envelope drops only in non-private (group) chats; /mint disabled
BOT_DEV=true
