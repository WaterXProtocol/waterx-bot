# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Added by cargo

/target

.claude/skills/

# macOS
.DS_Store

# Live bot config — contains the Telegram token. Never commit.
# (`.env*.example` templates are tracked explicitly below.)
.env
.env.dev
.env.local
# Legacy JSON config (no longer used, but kept as a credential safety net).
bot_shadow.json
# Generic safety net for any other local-only config.
*.local.json
# SQLite database files generated at runtime (user balances, fruit, etc.)
# `waterx.db` is the live file; the others are SQLite WAL/journal artefacts.
waterx.db
waterx.db-journal
waterx.db-wal
waterx.db-shm
# Catch-all for any other .db (backups, tests, etc.)
*.db
*.db-journal
*.db-wal
*.db-shm
# Rolling full-DB snapshots from the periodic auto-backup (+ its temp file).
*.db.bak
*.db.bak.tmp

# /redeploy marker (runtime, holds the chat id to notify on next startup)
redeploy.notify
