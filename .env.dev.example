# Copy this file to `.env.dev` and fill in real values, then run the dev bot:
#   ENV_FILE=.env.dev cargo run
# (Production uses `.env`, loaded by default with a plain `cargo run`.)
#
# Dev and production MUST use different bot tokens — one Telegram token can't be
# polled by two running bots at once (getUpdates conflicts).

# Required: Telegram bot token from @BotFather (the DEV bot)
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_DEV_BOT_TOKEN

# Required: your Telegram user id (numeric) — for owner-only commands
BOT_OWNER=0

# Dev mode → envelope drops anywhere (groups *and* private); uses waterx-dev.db
BOT_DEV=true
